<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
<!--    <style name="Theme.Diafarms" parent="Theme.MaterialComponents.DayNight.NoActionBar">-->
    <style name="Theme.Diafarms" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/light_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color — vert vif de l'accueil, plus cohérent que le
             teal du template par défaut jamais retouché depuis la création du projet. -->
        <item name="colorSecondary">@color/green_bright</item>
        <item name="colorSecondaryVariant">@color/green_bright_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- FORCER LE FOND BLANC -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Status bar color. -->
        <!-- S <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>-->
       <!-- Customize your theme here. -->

        <!-- Tentative de système de formes M3 global (shapeAppearanceCornerSmall/
             Medium/Large) retirée : coïncidait avec un entête délavé sur un appareil,
             mais le vrai coupable identifié ensuite est ThemeOverlay.Diafarms.
             NoElevationOverlay (voir activity_home.xml) — gardé simple ici. -->
    </style>

    <!-- Désactive la superposition M3 "elevation overlay" (teinte de surface selon
         l'élévation) pour une vue précise. Sans ça, sur certains appareils (constaté
         en direct : dépend du mode sombre/clair du système, indépendamment du thème
         "Light" forcé de l'appli), AppBarLayout ignore son android:background et
         affiche la couleur de surface M3 par défaut (violet pâle du thème de base). -->
    <style name="ThemeOverlay.Diafarms.NoElevationOverlay" parent="">
        <item name="elevationOverlayEnabled">false</item>
    </style>

</resources>