<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_saisie_form"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="72dp"
            android:paddingBottom="32dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvTitreForm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saisie"
                android:textColor="@color/primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProjetForm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                tools:text="P-001 — Poussins Oct 2025" />

            <View android:layout_width="match_parent" android:layout_height="20dp" />

            <!-- Bâtiment (optionnel, commun à tous les types) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bâtiment (optionnel)"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerBatiment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_border" />

            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- Date / Heure -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Heure (optionnel)"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHeure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="20dp" />

            <!-- ===================== COLLECTE D'ŒUFS ===================== -->
            <LinearLayout
                android:id="@+id/groupCollecte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Unité de saisie" android:textColor="@android:color/black" android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <RadioGroup
                    android:id="@+id/radioGroupUniteCollecte"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <RadioButton
                        android:id="@+id/radioUniteCollecteOeuf"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Œuf" android:checked="true" />
                    <RadioButton
                        android:id="@+id/radioUniteCollecteAlveole"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Alvéole (30 œufs)" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOeufsCollectes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Œufs collectés">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOeufsCollectes"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Œufs cassés">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOeufsCasses"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvResumeCollecte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===================== SOINS ===================== -->
            <LinearLayout
                android:id="@+id/groupSoins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Type de soin" android:textColor="@android:color/black" android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <Spinner
                    android:id="@+id/spinnerTypeSoin"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_border" />

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Produit">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProduit"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Quantité">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantiteSoin"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Observations (optionnel)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etObservationsSoin"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textMultiLine" android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== MORTALITÉ ===================== -->
            <LinearLayout
                android:id="@+id/groupMortalite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nombre de sujets morts">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreMorts"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Cause (ex: Chaleur, Maladie...)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCauseMortalite"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== RÉFORME (Production : comptage pur, jamais de prix) ===================== -->
            <LinearLayout
                android:id="@+id/groupReforme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEffectifReformeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:textColor="@android:color/darker_gray"
                    tools:text="Sujets vivants disponibles : 688" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nombre de sujets réformés">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreSujetsReforme"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Cause (optionnel)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCauseReforme"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== ALIMENTATION — ACHAT (entrant) ===================== -->
            <LinearLayout
                android:id="@+id/groupAlimentationAchat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nom de l'aliment">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNomAliment"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nombre de sacs (optionnel)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSac"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Quantité (kg)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantiteKgAchat"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Observations (optionnel)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etObservationsAchat"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textMultiLine" android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== ALIMENTATION — CONSOMMATION (sortie) ===================== -->
            <LinearLayout
                android:id="@+id/groupConsommation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStockInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:textColor="@android:color/darker_gray"
                    tools:text="Stock restant : 120 kg" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Quantité consommée (kg)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantiteKgConso"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== VENTE D'ŒUFS (Finance : ferme entière, pas un projet) ===================== -->
            <LinearLayout
                android:id="@+id/groupVenteOeufs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStockOeufsInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:textColor="@android:color/darker_gray"
                    tools:text="Disponible à la vente (ferme) : 250 œuf(s) (8 alvéole(s) + 10)" />

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Unité de vente" android:textColor="@android:color/black" android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <RadioGroup
                    android:id="@+id/radioGroupUniteVenteOeufs"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <RadioButton
                        android:id="@+id/radioUniteVenteOeuf"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Œuf" android:checked="true" />
                    <RadioButton
                        android:id="@+id/radioUniteVenteAlveole"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Alvéole (30 œufs)" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilQuantiteOeufsVente"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nombre d'œufs vendus">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantiteOeufsVente"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPrixUnitaireOeufs"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Prix unitaire (FCFA, optionnel)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrixUnitaireOeufs"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Montant total de la vente (FCFA)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMontantVenteOeufs"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== VENTE RÉFORME (Finance : ferme entière, pas un projet) ===================== -->
            <LinearLayout
                android:id="@+id/groupVenteReforme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStockReformeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="13sp"
                    android:textColor="@android:color/darker_gray"
                    tools:text="Disponible à la vente (ferme) : 40 sujet(s)" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Nombre de sujets vendus">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreSujetsVente"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Prix unitaire (FCFA, optionnel)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrixUnitaireReforme"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Montant total de la vente (FCFA)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMontantVenteReforme"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===================== TRANSACTION (finance) ===================== -->
            <LinearLayout
                android:id="@+id/groupTransaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Catégorie" android:textColor="@android:color/black" android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <Spinner
                    android:id="@+id/spinnerCategorie"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input_border" />

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Montant (FCFA)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMontant"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Description">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescriptionTransaction"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <View android:layout_width="match_parent" android:layout_height="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <CheckBox
                        android:id="@+id/checkCommun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dépense/rentrée commune (non liée à ce seul projet)"
                        android:textSize="13sp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>

                <!-- Visible seulement si "commune" est coché : répartit la dépense/rentrée
                     sur les projets actifs sélectionnés (voir SaisieFormActivity, qui
                     peuple ce conteneur dynamiquement à partir des projets en cache). -->
                <LinearLayout
                    android:id="@+id/groupProjetsConcernes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#E5E7EB" android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Projets concernés"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                        <TextView
                            android:id="@+id/btnToutSelectionner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tout désélectionner"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerProjetsConcernes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValiderForm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enregistrer"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/primary" />

            <TextView
                android:id="@+id/tvNoteLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enregistré sur l'appareil — synchronisez depuis l'accueil quand vous êtes en ligne."
                android:textSize="12sp"
                android:textAlignment="center"
                android:textColor="@android:color/darker_gray" />

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btnBackForm"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_white"
