<?xml version="1.0" encoding="utf-8"?>
<!-- padding, pas margin : AlertDialog.setView() force ses propres LayoutParams sur la
     racine inflatée (inflate appelé avec root=null), donc un layout_margin ici serait
     ignoré comme sur item_saisie_locale.xml — le padding, lui, est une propriété de la
     vue elle-même et reste appliqué quels que soient les LayoutParams du parent. -->
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    app:endIconMode="password_toggle">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mot de passe hors ligne"
        android:inputType="textPassword" />

</com.google.android.material.textfield.TextInputLayout>
